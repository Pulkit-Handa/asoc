# ─────────────────────────────────────────────────────────────────────────────
# ASOC Environment Configuration
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── EMBEDDINGS — COMPLETELY FREE, NO KEY NEEDED ───────────────────────────────
# ChromaDB semantic search uses a local HuggingFace sentence-transformers model.
# The model downloads automatically on first run, then runs entirely on your machine.
# No API key. No per-call cost. No rate limits.
#
# Options (all free):
#   all-MiniLM-L6-v2        → Fast, 80MB,  good quality  (DEFAULT)
#   BAAI/bge-small-en-v1.5  → 130MB, excellent retrieval quality (RECOMMENDED for prod)
#   BAAI/bge-base-en-v1.5   → 440MB, highest quality, needs 8GB+ RAM
#   all-mpnet-base-v2       → 420MB, strong general-purpose model
#   thenlper/gte-small      → 70MB,  fastest option
#
# ⚠️  DO NOT change this after you have stored lessons — old and new vectors
#     are incompatible. If you change it, re-seed: python scripts/seed_topology.py
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Force CPU even if a GPU is available (optional — auto-detected by default)
# EMBEDDING_DEVICE=cpu


# ── LLM (for Critic Agent lesson generation only) ─────────────────────────────
# The LLM is ONLY used by the Critic Agent to write lessons in natural language.
# Choose your provider:
#
#   anthropic    → Best reasoning quality. Needs ANTHROPIC_API_KEY. (Paid)
#   openai       → Good alternative.      Needs OPENAI_API_KEY.    (Paid)
#   ollama       → FREE. Runs locally. Install: https://ollama.com
#                  Then: ollama pull llama3.2 && ollama serve
#   huggingface  → FREE tier (rate-limited). Needs HF_API_TOKEN.
#
LLM_PROVIDER=anthropic

# Anthropic key — only needed if LLM_PROVIDER=anthropic
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_OR_DELETE_IF_USING_OLLAMA
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI key — only needed if LLM_PROVIDER=openai
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_MODEL=gpt-4o-mini

# Ollama settings — only needed if LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace settings — only needed if LLM_PROVIDER=huggingface
# Get a free token at: https://huggingface.co/settings/tokens
# HF_API_TOKEN=hf_REPLACE_ME
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3


# ── Databases ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://asoc:asoc_dev_password@localhost:5432/asoc

REDIS_HOST=localhost
REDIS_PORT=6379

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=asoc
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Set to true to use a local folder instead of Docker ChromaDB (no docker needed)
# CHROMADB_PERSISTENT=true
# CHROMADB_PERSIST_PATH=./chroma_data


# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_CONSUMER_GROUP=asoc-triage-worker
KAFKA_BATCH_SIZE=50


# ── API Security ──────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING

# Static API keys for SIEM/webhook integrations (comma-separated)
API_KEYS=dev-simulation-key,your-siem-key-here


# ── Development ───────────────────────────────────────────────────────────────
# Set to true to skip JWT auth entirely (never use in production)
ASOC_DEV_MODE=true
CORS_ORIGINS=http://localhost:3000


# ── ML Models ─────────────────────────────────────────────────────────────────
# Path to fine-tuned SecBERT checkpoint (leave empty to use base model)
SECBERT_MODEL_PATH=


# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_PUSHGATEWAY=localhost:9091
